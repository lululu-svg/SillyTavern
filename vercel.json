{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { 
      "src": "/public/(.*)", 
      "dest": "/public/$1" 
    },
    { 
      "src": "/(.*)", 
      "dest": "/server.js" 
    }
  ]
}
